# Docker Compose 환경변수
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# ====================
# 보안 및 인증
# ====================

# JWT Secret (최소 32자 이상 권장)
# 프로덕션에서는 반드시 강력한 랜덤 문자열로 변경하세요
JWT_SECRET=your-secret-key-change-this-in-production

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# ====================
# 데이터베이스 설정
# ====================

# PostgreSQL 사용자명
POSTGRES_USER=chatbot

# PostgreSQL 비밀번호 (프로덕션에서는 반드시 변경하세요)
POSTGRES_PASSWORD=chatbot_password

# PostgreSQL 데이터베이스명
POSTGRES_DB=chatbot

# 데이터베이스 연결 URL
# 형식: postgresql://[사용자명]:[비밀번호]@[호스트]:[포트]/[데이터베이스명]
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ====================
# 포트 설정
# ====================

# 백엔드 API 서버 포트
BACKEND_PORT=4000

# 프론트엔드 웹 서버 포트
FRONTEND_PORT=3000

# PostgreSQL 데이터베이스 포트
POSTGRES_PORT=5432

# ====================
# API 설정
# ====================

# 프론트엔드에서 접근할 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# ====================
# 에스컬레이션 설정 (F-06)
# ====================

# 에스컬레이션 트리거 신뢰도 임계값 (0.0 ~ 1.0)
# 분류 신뢰도가 이 값보다 낮으면 자동으로 상담원에게 에스컬레이션됩니다
ESCALATION_CONFIDENCE_THRESHOLD=0.5
